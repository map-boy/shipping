# Server-side secrets. These stay on Cloud Functions and are never shipped to the browser.
# Set them with:  firebase functions:secrets:set NAME
# (or place them in functions/.env for local emulator runs - that file is gitignored)

MOMO_ENV=sandbox
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=

# Required. The admin callables refuse to run unless BOTH of these are set,
# so an unconfigured deployment fails closed instead of open.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Region and capacity. Leave FUNCTIONS_REGION unset to keep us-central1.
# Changing it means deleting the previously deployed functions first, and it
# should match your Realtime Database region.
# FUNCTIONS_REGION=africa-south1
# FUNCTIONS_MAX_INSTANCES=40

# Region of your Realtime Database instance, which is NOT always the region the
# functions run in. The onTripEvent trigger fails to deploy with "pattern cannot
# match any databases in region ..." when this is wrong.
# Find it in your databaseURL: https://<name>.<region>.firebasedatabase.app
# A legacy https://<name>.firebaseio.com URL means us-central1.
# RTDB_REGION=us-central1
# RTDB_INSTANCE=            # only for a non-default database instance

# The onTripEvent database trigger is off unless this is true, so a wrong
# RTDB_REGION cannot fail the whole deploy. Only notifications, receipts and
# analytics depend on it - booking, dispatch, payment and tracking do not.
# ENABLE_TRIP_EVENT_TRIGGER=true
