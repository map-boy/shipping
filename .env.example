# Copy to .env.local and fill in. Never commit the filled-in file.
# Everything with a VITE_ prefix is bundled into the public JavaScript, so only
# put values here that are safe for anyone to read. Firebase web config is one of
# those - it is an identifier, not a secret, and the database rules are what
# actually protect your data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Restrict this key by HTTP referrer in the Google Cloud console, otherwise
# anyone can lift it from the bundle and bill your account.
VITE_GOOGLE_MAPS_API_KEY=
